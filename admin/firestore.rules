rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "4FCRIlDIBdZ0feptCOAuysOMfC32";
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "4FCRIlDIBdZ0feptCOAuysOMfC32";
    }
  }
}
